{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jules-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" }],
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "CONTROL_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "GATEWAY_DISABLED": "true",
    "PUBLIC_ORIGIN": "https://gateway.example.test",
    "ALLOWED_ORIGINS_JSON": "[]"
  }
}
